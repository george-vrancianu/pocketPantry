NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/pocket_pantry
# Integration tests run against this database (docker compose service postgres-test).
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5433/pocket_pantry_test
CLIENT_ORIGIN=http://localhost:5173
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters

# Scan Cap: Scans per Member per UTC day (0 disables the cap), and the Match confidence below which a line is Unmatched.
SCAN_DAILY_CAP=30
SCAN_MATCH_CONFIDENCE_THRESHOLD=0.6

# AI scan provider.
AI_PROVIDER=openai
AI_API_KEY=
AI_VISION_MODEL=gpt-4o-mini-2024-07-18
# Required for AI_PROVIDER=openai-compatible, e.g. https://vendor.example/v1
# AI_BASE_URL=
