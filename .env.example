NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/pocket_pantry
# Integration tests run against this database (docker compose service postgres-test).
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5433/pocket_pantry_test
# The address you open the app at. Set it to your HTTPS tunnel or public address when using one.
CLIENT_ORIGIN=http://localhost:5173
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters

# Scan Cap: Scans per Member per UTC day (0 disables the cap), and the Match confidence below which a line is Unmatched.
SCAN_DAILY_CAP=30
SCAN_MATCH_CONFIDENCE_THRESHOLD=0.6

# Signs the short-lived Plate Scan token (HMAC-SHA256, at least 32 characters). REQUIRED in production,
# e.g. `openssl rand -base64 48`; elsewhere a missing one becomes a random per-process secret (tokens do not survive a restart). Never log it.
# SCAN_TOKEN_SECRET=

# Development only: save every Scan's photos, prompt and raw AI answer to this folder
# (relative to apps/api) to improve recognition. Ignored unless NODE_ENV=development; the API
# refuses to start with it in production. Receipts are personal data: keep `.scan-debug` (gitignored)
# or a folder outside the repo, and clear it out.
# SCAN_DEBUG_DIR=.scan-debug

# AI scan provider.
AI_PROVIDER=openai
AI_API_KEY=
AI_VISION_MODEL=gpt-4o-mini-2024-07-18
# Required for AI_PROVIDER=openai-compatible, e.g. https://vendor.example/v1
# AI_BASE_URL=

# Production: serve the built web app (`npm run build`) from the API, relative to apps/api.
# WEB_DIST_DIR=../web/dist
