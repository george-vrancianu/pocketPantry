NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/pocket_pantry
# Integration tests run against this database (docker compose service postgres-test).
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5433/pocket_pantry_test
# The address you open the app at. Set it to your HTTPS tunnel or public address when using one.
CLIENT_ORIGIN=http://localhost:5173
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters

# Scan Cap: Scans per Member per UTC day (0 disables the cap), and the Match confidence below which a line is Unmatched.
SCAN_DAILY_CAP=30
# Voice Cap: Voice Notes per Member per UTC day (0 disables the cap).
VOICE_DAILY_CAP=50
# Assistant Cap: Assistant Requests per Member per UTC day (0 disables the cap).
ASSISTANT_DAILY_CAP=50
# Link Cap: Recipe from Link reads per Member per UTC day (0 disables the cap).
LINK_DAILY_CAP=20
SCAN_MATCH_CONFIDENCE_THRESHOLD=0.6

# Meal Plans a Family may keep, past ones included.
MEAL_PLAN_CAP=10

# Signs the short-lived Plate Scan token (HMAC-SHA256, at least 32 characters). REQUIRED in production,
# e.g. `openssl rand -base64 48`; elsewhere a missing one becomes a random per-process secret (tokens do not survive a restart). Never log it.
# SCAN_TOKEN_SECRET=

# Development only: save every Scan's photos, prompt and raw AI answer to this folder
# (relative to apps/api) to improve recognition. Voice Notes save their recording, transcription
# request, transcript and transcript read too. Ignored unless NODE_ENV=development; the API
# refuses to start with it in production. Receipts and voice recordings are personal data: keep
# `.scan-debug` (gitignored) or a folder outside the repo, and clear it out.
# SCAN_DEBUG_DIR=.scan-debug

# AI scan provider.
AI_PROVIDER=openai
AI_API_KEY=
# Unset: gpt-6-luna at reasoning effort `none`. The default effort only comes with the
# default model: set AI_VISION_MODEL yourself and no effort is sent unless you set one.
# AI_VISION_MODEL=gpt-6-luna
# none, minimal, low, medium, high or xhigh. gpt-6-luna keeps temperature 0 only at `none`
# and has no `minimal`. openai-compatible vendors: leave unset unless they take reasoning_effort.
# AI_REASONING_EFFORT=none
# Back to gpt-4o-mini until it shuts down on January 14, 2027 (effort left out or empty):
# AI_VISION_MODEL=gpt-4o-mini-2024-07-18
# Voice Notes: audio transcription model, on the same key and base URL. Voice is off without AI_API_KEY.
# AI_TRANSCRIBE_MODEL=gpt-transcribe
# Voice Notes: the text model that reads a transcript into Voice Actions (separate from the vision
# model). Unset, it runs gpt-5-mini at effort low; a model set without AI_TEXT_REASONING_EFFORT sends no effort.
# AI_TEXT_MODEL=gpt-5-mini
# AI_TEXT_REASONING_EFFORT=low
# Required for AI_PROVIDER=openai-compatible, e.g. https://vendor.example/v1
# AI_BASE_URL=

# Production: serve the built web app (`npm run build`) from the API, relative to apps/api.
# WEB_DIST_DIR=../web/dist


# Open Food Facts (Barcode Lookup). Optional; these are the defaults.
# OPEN_FOOD_FACTS_BASE_URL=https://world.openfoodfacts.org
# OPEN_FOOD_FACTS_USER_AGENT=PocketPantry/1.0 (https://github.com/george-vrancianu/pocketPantry)
